{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decentralized-agentic-refund-ops/specs/002-a2a-runtime-contract/agent-card.schema.json",
  "title": "AgentCard",
  "description": "A2A Agent Card (PoC subset) published to local.agent.agent-card.published.v1 as the payload of envelopes whose event_type is agent.agent_card.v1. Latest card per agent_id wins (compacted).",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "name", "description", "version", "endpoint_topic", "capabilities"],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "endpoint_topic": {
      "type": "string",
      "minLength": 1,
      "description": "The agent's request topic — its addressable A2A endpoint."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Capability" }
    },
    "security": {
      "type": "string",
      "enum": ["none"],
      "default": "none",
      "description": "Auth-metadata stub. 'none' = no authentication in this PoC. Real auth/TLS/ACLs deferred per Principle V."
    }
  },
  "$defs": {
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        }
      }
    }
  }
}
